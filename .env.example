APP_NAME="Sync360 Control App"
APP_ENV=local
APP_KEY=base64:rL9Do7A66OoWCEQXdLhzoVkdIly6rR/QfPSh8OGz2pE=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sync360
DB_USERNAME=sync360
DB_PASSWORD=sync360

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

TENANT_RUNTIME_ROOT=/var/www/html/runtime/tenants
TENANT_TEMPLATE_ROOT=/var/www/html/templates/tenant
TENANT_PORT_RANGE_START=4100
TENANT_PORT_RANGE_END=4199
TENANT_PROVISIONING_DRIVER=openclaw
TENANT_PROVISIONING_DELAY_SECONDS=3
SYNC360_HOST_PROJECT_ROOT=
SYNC360_HOST_PORT_PROBE_HOST=host.docker.internal
SYNC360_HOST_PORT_PROBE_TIMEOUT_SECONDS=1

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_SERVICE_NAME=openclaw-gateway
OPENCLAW_COMPOSE_FILENAME=compose.yaml
OPENCLAW_CONTAINER_HOME=/home/node/.openclaw
OPENCLAW_GATEWAY_INTERNAL_PORT=18789
OPENCLAW_READINESS_PATH=/readyz
OPENCLAW_READINESS_PROBE_HOST=host.docker.internal
OPENCLAW_READINESS_TIMEOUT_SECONDS=45
OPENCLAW_READINESS_POLL_INTERVAL_MS=1000
OPENCLAW_COMPOSE_TIMEOUT_SECONDS=600

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
