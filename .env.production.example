APP_NAME="Sync360 Control App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.sync360.co.nz
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sync360
DB_USERNAME=sync360
DB_PASSWORD=change-me-now

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=app.sync360.co.nz
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

TENANT_RUNTIME_ROOT=/var/www/html/runtime/tenants
TENANT_TEMPLATE_ROOT=/var/www/html/templates/tenant
TENANT_PORT_RANGE_START=4100
TENANT_PORT_RANGE_END=4199
TENANT_PROVISIONING_DRIVER=openclaw
TENANT_PROVISIONING_DELAY_SECONDS=3

SYNC360_ADMIN_LOCAL_ONLY=false
SYNC360_INFRASTRUCTURE_DRIVER=ssh
SYNC360_RUN_SEED=true
SYNC360_QUEUE_TRIES=1
SYNC360_QUEUE_TIMEOUT=180
SYNC360_QUEUE_SLEEP=1
SYNC360_QUEUE_MAX_TIME=3600
SYNC360_LOCAL_DOCKER_COMPOSE_BIN="docker compose"
SYNC360_SSH_TIMEOUT_SECONDS=30
SYNC360_SCP_TIMEOUT_SECONDS=120
SYNC360_SSH_CONNECT_TIMEOUT_SECONDS=10
SYNC360_SSH_BIN=ssh
SYNC360_SCP_BIN=scp
SYNC360_SSHPASS_BIN=sshpass
SYNC360_HOST_PROJECT_ROOT=
SYNC360_HOST_PORT_PROBE_HOST=127.0.0.1
SYNC360_HOST_PORT_PROBE_TIMEOUT_SECONDS=1
SYNC360_WORKSPACE_PUBLIC_READY_TIMEOUT_SECONDS=120
SYNC360_WORKSPACE_PUBLIC_READY_POLL_INTERVAL_MS=1500
SYNC360_CONTROL_DEPLOY_ENABLED=true
SYNC360_CONTROL_DEPLOY_SSH_HOST=161.97.74.128
SYNC360_CONTROL_DEPLOY_SSH_PORT=22
SYNC360_CONTROL_DEPLOY_SSH_USER=deploy
SYNC360_CONTROL_DEPLOY_SSH_AUTH_MODE=password
SYNC360_CONTROL_DEPLOY_SSH_PASSWORD_ENV_KEY=SYNC360_CONTROL_SERVER_SSH_PASSWORD
SYNC360_CONTROL_SERVER_SSH_PASSWORD=
SYNC360_CONTROL_DEPLOY_REPO_PATH=/opt/sync360/control-app
SYNC360_CONTROL_DEPLOY_BRANCH=codex/control-app-prod-deploy
SYNC360_CONTROL_DEPLOY_COMPOSE_FILE=docker-compose.prod.yml
SYNC360_CONTROL_DEPLOY_SCRIPT_PATH=/opt/sync360/control-app/deploy/scripts/run-control-app-deploy.sh
SYNC360_CONTROL_DEPLOY_STATUS_FILE=/opt/sync360/control-app/storage/logs/control-app-deploy.status
SYNC360_CONTROL_DEPLOY_LOG_FILE=/opt/sync360/control-app/storage/logs/control-app-deploy.log
SYNC360_CONTROL_DEPLOY_LOG_TAIL_LINES=20
SYNC360_CONTROL_DEPLOY_TIMEOUT_SECONDS=30

SYNC360_SUPER_ADMIN_NAME="Sync360 Super Admin"
SYNC360_SUPER_ADMIN_EMAIL=ops@sync360.co.nz
SYNC360_SUPER_ADMIN_PASSWORD=change-me-now
SYNC360_RESET_SUPER_ADMIN_PASSWORD=false

SYNC360_CLIENT_VPS_SSH_PASSWORD=
SYNC360_CLIENT_VPS_SUDO_PASSWORD=

SYNC360_DEFAULT_SERVER_NAME=sync360-client-vps-1
SYNC360_DEFAULT_SERVER_HOST=89.116.28.191
SYNC360_DEFAULT_SERVER_SSH_HOST=89.116.28.191
SYNC360_DEFAULT_SERVER_SSH_PORT=22
SYNC360_DEFAULT_SERVER_SSH_USER=deploy
SYNC360_DEFAULT_SERVER_SSH_PRIVATE_KEY_PATH=
SYNC360_DEFAULT_SERVER_SSH_AUTH_MODE=password
SYNC360_DEFAULT_SERVER_SSH_PASSWORD_ENV_KEY=SYNC360_CLIENT_VPS_SSH_PASSWORD
SYNC360_DEFAULT_SERVER_SUDO_PASSWORD_ENV_KEY=SYNC360_CLIENT_VPS_SUDO_PASSWORD
SYNC360_DEFAULT_SERVER_RUNTIME_ROOT=/srv/sync360/runtime
SYNC360_DEFAULT_SERVER_WORKSPACE_SCHEME=https
SYNC360_DEFAULT_SERVER_WORKSPACE_BASE_DOMAIN=workspace.sync360.co.nz
SYNC360_DEFAULT_SERVER_DOCKER_COMPOSE_BIN="docker compose"
SYNC360_DEFAULT_SERVER_CADDY_SITES_PATH=/etc/caddy/sites
SYNC360_DEFAULT_SERVER_CADDY_RELOAD_COMMAND="systemctl reload caddy"

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_SERVICE_NAME=openclaw-gateway
OPENCLAW_COMPOSE_FILENAME=compose.yaml
OPENCLAW_CONTAINER_HOME=/home/node/.openclaw
OPENCLAW_GATEWAY_INTERNAL_PORT=18789
OPENCLAW_READINESS_PATH=/readyz
OPENCLAW_READINESS_TIMEOUT_SECONDS=45
OPENCLAW_READINESS_POLL_INTERVAL_MS=1000
OPENCLAW_COMPOSE_TIMEOUT_SECONDS=600
LITELLM_BASE_URL=https://litellm.stylesoftware.co.nz
LITELLM_VIRTUAL_KEY=
LITELLM_MASTER_KEY=
JINA_BASE_URL=https://r.jina.ai
JINA_API_KEY=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
TELEGRAM_API_BASE_URL=https://api.telegram.org
LITELLM_DEFAULT_PLAN_NAME=trial
LITELLM_DEFAULT_MAX_BUDGET=25
LITELLM_DEFAULT_BUDGET_DURATION=monthly
LITELLM_TRIAL_MAX_BUDGET=25

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sync360.co.nz"
MAIL_FROM_NAME="${APP_NAME}"

BREVO_ENABLED=true
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@sync360.co.nz
BREVO_SENDER_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
